# Копируйте в .env и задавайте реальные значения только локально.
# Этот файл не должен содержать токены, пароли, реальные URL или персональные данные.

DB_PATH=database.sqlite
APP_ENV=development
TIMEZONE_OFFSET=3
LOG_FILE=logs/rso_portal.log
LOG_LEVEL=INFO

TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# Production: уникальное значение длиной не менее 32 символов.
SECRET_KEY=
# Необязателен в development. Для первого production-администратора задайте
# одноразовый пароль длиной не менее 12 символов и смените его после входа.
BOOTSTRAP_ADMIN_PASSWORD=

API_HOST=127.0.0.1
API_PORT=8000
FASTAPI_BASE_URL=http://127.0.0.1:8000
# Production: обязателен. Небезопасный режим разрешён только локально.
INTERNAL_API_TOKEN=
ALLOW_INSECURE_DEV_API=false

# По умолчанию интеграция выключена. Mock разрешён только для development/test.
# В production задайте MOCK=false и реальные BASE_URL/AUTH_TOKEN до включения.
ENABLE_1C_INTEGRATION=false
INTEGRATION_1C_MOCK=true
INTEGRATION_1C_BASE_URL=https://example.invalid/publication/hs/service
INTEGRATION_1C_AUTH_TOKEN=
INTEGRATION_1C_AUTH_TIMEOUT_SECONDS=5
INTEGRATION_1C_SYNC_TIMEOUT_SECONDS=60
INTEGRATION_1C_SYNC_PERIOD_HOURS=24
INTEGRATION_1C_SYNC_RETRY_HOURS=1
INTEGRATION_1C_BATCH_SIZE=500
INTEGRATION_1C_CODE_TTL_MINUTES=10
INTEGRATION_1C_CODE_MAX_ATTEMPTS=5
INTEGRATION_1C_MOCK_CODE=000000

# YandexGPT: секреты задаются только в окружении/серверном Secret.
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEXGPT_TIMEOUT_SECONDS=20
