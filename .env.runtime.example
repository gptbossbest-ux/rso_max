# Серверные значения, подключаемые после пользовательского .env.
# Нужен только при первом запуске с пустой базой. Минимум 12 символов;
# после первого входа приложение потребует сменить этот пароль.
BOOTSTRAP_ADMIN_PASSWORD=

# YandexGPT secrets (set on the server, never commit real values).
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
OPERATOR_CHAT_IMAGE_DIR=/app/data/operator_chat_images
