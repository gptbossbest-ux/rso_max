# Серверные значения, подключаемые после пользовательского .env.
# Нужен только при первом запуске с пустой базой. Минимум 12 символов;
# после первого входа приложение потребует сменить этот пароль.
BOOTSTRAP_ADMIN_PASSWORD=

# YandexGPT secrets (set on the server, never commit real values).
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
OPERATOR_CHAT_IMAGE_DIR=/app/data/operator_chat_images
MAX_IMAGE_DOWNLOAD_HOSTS=iu.oneme.ru

# Flask/Gunicorn web portal. Invalid or out-of-range values fail startup.
WEB_WORKERS=2
WEB_THREADS=4
WEB_TIMEOUT=60

# Set after observing the exact immediate proxy address in the deployed contour.
TRUSTED_PROXY_CIDRS=
EXPECT_REVERSE_PROXY=false
