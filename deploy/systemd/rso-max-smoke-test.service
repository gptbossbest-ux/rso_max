[Unit]
Description=RSO MAX test stack read-only smoke checks
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=botadmin
Group=botadmin
WorkingDirectory=/srv/bot-sandbox/current/test
RuntimeDirectory=rso-max-smoke-test
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/timeout --foreground --signal=TERM 115s /usr/bin/flock --no-fork --nonblock /run/rso-max-smoke-test/smoke.lock /usr/local/libexec/rso-max-smoke test
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
Environment=DOCKER_CONFIG=/tmp/rso-max-docker-config
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/rso-max-smoke-test
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
