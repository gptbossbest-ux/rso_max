[Unit]
Description=RSO MAX automatic Full deployment to production
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=botadmin
Group=botadmin
WorkingDirectory=/srv/bot-sandbox
EnvironmentFile=/etc/rso-max-deploy/github.conf
Environment=DOCKER_CONFIG=/tmp/rso-max-docker-config
UMask=0077
ExecStart=/usr/bin/timeout --foreground --signal=TERM --kill-after=1000s 1800s /usr/local/libexec/rso-max-auto-deploy full
TimeoutStartSec=2850
TimeoutStopSec=1050
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/bot-sandbox
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
